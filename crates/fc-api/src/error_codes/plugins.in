// Plugins (v0.7).
// Entries of the `error_codes!` macro in `../error.rs` (see there). Never rename or reuse a code.
/// The package is unreadable or invalid (`details.reason`).
ValidationPluginPackage => Validation, "errors.validation.plugin_package";
/// The manifest is invalid (`details`: `field`, `reason`).
ValidationPluginManifest => Validation, "errors.validation.plugin_manifest";
/// The plugin targets a plugin API version this app does not run (`details.api_version`).
ValidationPluginApiVersion => Validation, "errors.validation.plugin_api_version";
/// The plugin needs a newer app (`details`: `required`, `current`).
ValidationPluginAppVersion => Validation, "errors.validation.plugin_app_version";
/// A permission was granted that the plugin did not request (`details.permission`).
ValidationPluginPermission => Validation, "errors.validation.plugin_permission";
/// Plugin not installed (`details.id`).
NotFoundPlugin => NotFound, "errors.not_found.plugin";
/// The plugin has no such command / view / model (`details`: `plugin_id`, `id`).
NotFoundPluginContribution => NotFound, "errors.not_found.plugin_contribution";
/// UI session not open (`details.session_id`).
NotFoundPluginSession => NotFound, "errors.not_found.plugin_session";
/// The plugin is disabled, broken or lacks the permission for this contribution (`details.id`).
ConflictPluginInactive => Conflict, "errors.conflict.plugin_inactive";
/// A `before:` hook rejected the call (`details`: `plugin_id`, `message`).
ConflictPluginRejected => Conflict, "errors.conflict.plugin_rejected";
/// The plugin failed: trap, out of fuel, deadline, memory cap, ABI violation or its own error
/// (`details`: `plugin_id`, `kind`, `code`).
ProviderPluginFailed => Provider, "errors.provider.plugin_failed";
