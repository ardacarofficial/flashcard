// Study (v0.2).
// Entries of the `error_codes!` macro in `../error.rs` (see there). Never rename or reuse a code.
/// Study session not found (`details.id`).
NotFoundSession => NotFound, "errors.not_found.session";
/// The session has ended (`details.id`).
ConflictSessionEnded => Conflict, "errors.conflict.session_ended";
/// The card is not available in the session now (`details.card_id`; refetch `study.session`).
ConflictNotCurrentCard => Conflict, "errors.conflict.not_current_card";
/// Scheduler parameters rejected (`details.reason`).
ValidationSchedulerParams => Validation, "errors.validation.scheduler_params";
/// v1.3: `study.start` found no card for the scope (`details.reason`: a `StudyEmptyReason`;
/// `details.next_available_at`: ms timestamp or null). No session was created; open sessions
/// are untouched.
ConflictNothingToStudy => Conflict, "errors.conflict.nothing_to_study";
