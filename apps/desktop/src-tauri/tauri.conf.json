{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flashcard",
  "identifier": "app.flashcard.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flashcard",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost fcmedia: http://fcmedia.localhost; media-src 'self' fcmedia: http://fcmedia.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Flashcard",
    "shortDescription": "Flashcard",
    "category": "Education",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "en-US",
          "tr-TR"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "flashcard"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyNjkwQTJFQzRBOEJFQTIKUldTaXZxakVMZ3BwRWtxWGplK3VkTm9JSmhLMFhCaGc0YzJlU2IwdTVaVkEwMnlTZFZWcUphejkK",
      "endpoints": [
        "https://github.com/ardacarofficial/flashcard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
