{
  "name": "fc-desktop-ui",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "i18n": "node scripts/merge-locales.mjs",
    "dev": "node scripts/merge-locales.mjs && vite",
    "dev:mock": "node scripts/merge-locales.mjs && vite --mode mock",
    "dev:bridge": "node scripts/merge-locales.mjs && vite --mode bridge",
    "build": "node scripts/merge-locales.mjs && vite build",
    "bundle:check": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "check": "node scripts/merge-locales.mjs && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "node scripts/merge-locales.mjs && vitest run",
    "tauri": "tauri",
    "screens": "node scripts/screens.mjs",
    "e2e": "node scripts/merge-locales.mjs && node e2e/run.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "highlight.js": "^11.12.0",
    "katex": "~0.16.47",
    "lucide": "0.460.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "jsdom": "^31.0.1",
    "playwright-core": "1.56.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "~5.8.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
