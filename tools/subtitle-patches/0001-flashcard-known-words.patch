+// Pages of 500 words: 200 of them are far more words than anyone learns; a server whose cursor never ends stops there
+export const KNOWN_WORDS_MAX_PAGES = 200;
+
+// "Flashcard'dan oku": the words the app knows and learns in a language, every page of them. The app says first
+// whether it shares them at all (`features.known_words` of /v1/me), and again on each page (`shared`), so the
+// settings can tell "sharing is off in the app" from "no words yet". Only known and learning words are taken.
+export async function readKnownWords(api: FlashcardsApi, lang: string): Promise<TKnownWordsAnswer> {
+  const me = await api.me();
+  if (me.features?.known_words === false) return { shared: false, words: [] };
+  const words: TKnownWord[] = [];
+  const seen = new Set<string>();
+  let cursor: string | undefined;
+  for (let page = 0; page < KNOWN_WORDS_MAX_PAGES; page++) {
+    const answer = await api.knownWords(lang, cursor);
+    if (!answer.shared) return { shared: false, words: [] };
+    words.push(...answer.words.filter((word) => word.status === "known" || word.status === "learning"));
+    if (!answer.next_cursor || seen.has(answer.next_cursor)) break;
+    seen.add(answer.next_cursor);
+    cursor = answer.next_cursor;
+  }
+  return { shared: true, words };
+}
+
 export function createFlashcards(deps: Partial<ConstructorParameters<typeof Outbox>[0]> = {}) {
+  const storage = deps.storage ?? chromeStorage;
   const outbox = new Outbox({ storage: chromeStorage, schedule: scheduleAlarm, ...deps });
   const apiOf = deps.api ?? ((server: { url: string; token: string }) => new FlashcardsApi(server.url, server.token));
 
@@ -64,6 +88,14 @@ export function createFlashcards(deps: Partial<ConstructorParameters<typeof Outb
       }
       case "decks":
         return { decks: await apiOf({ url: request.url ?? "", token: request.token ?? "", deckId: null }).decks() };
+      // With the saved server and key: the request needs them, and the server lets the background in (CORS)
+      case "knownWords": {
+        const server = parseServer((await storage.get([KEYS.server]))[KEYS.server]);
+        if (!server?.url) {
+          throw new FlashcardsApiError("rejected", "Önce Subtitle Kartları'nın sunucu adresini ve anahtarını kaydet");
+        }
+        return readKnownWords(apiOf(server), request.lang);
+      }
     }
   }
 
