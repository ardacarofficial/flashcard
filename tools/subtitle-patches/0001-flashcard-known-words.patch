 // Three weeks between reviews: Anki calls such a card mature
 export const MATURE_INTERVAL_DAYS = 21;
 
+type TReadWord = { word: string; status: "learning" | "known"; translation?: string };
+type TReadSource = "anki" | "flashcards";
+
+// Merges words read back from a learning service into the saved ones, under their dictionary form as the subtitles
+// look them up: a word the user knows stays known whatever the service says, the others take its status and are
+// flagged as the service's. Returns the words and how many changed.
+async function mergeReadWords(
+  words: Record<string, TSavedWord>,
+  language: string,
+  read: TReadWord[],
+  source: TReadSource,
+): Promise<{ words: Record<string, TSavedWord>; changed: number }> {
+  const forms = read.map((item) => normalizeWord(item.word, language)).filter((word): word is string => !!word);
+  const ranks = frequencyLanguage(language)
+    ? await requestWordRanks({ language, words: [...new Set(forms)] }).catch(() => ({}))
+    : {};
+  const next = { ...words };
+  const now = Date.now();
+  let changed = 0;
+  for (const item of read) {
+    const form = normalizeWord(item.word, language);
+    if (!form) continue;
+    const word = (ranks as Record<string, TWordRank | null>)[form]?.[0] ?? form;
+    const key = wordKey(language, word);
+    const { status } = item;
+    const saved = next[key];
+    // A word the user knows stays known whatever the service says
+    if (saved?.status === "known" || (saved?.status === status && saved[source])) continue;
