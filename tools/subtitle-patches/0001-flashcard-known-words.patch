@@ -0,0 +1,144 @@
+import { describe, expect, it, vi } from "vitest";
+
+import { FlashcardsApi, type TKnownWord } from "./api";
+import { KNOWN_WORDS_MAX_PAGES, createFlashcards, readKnownWords } from "./background";
+import { KEYS, type TStorage } from "./outbox";
+
+// "Flashcard'dan oku" in the background: every page of GET /v1/known-words, with the saved server and key, and
+// whether the app shares the words at all
+
+const SERVER = "http://127.0.0.1:28735/subtitle";
+
+const word = (lemma: string, status: TKnownWord["status"]): TKnownWord => ({ lemma, lang: "en", status });
+
+type TServer = {
+  shared?: boolean;
+  // /v1/me's features.known_words; undefined: an older server that doesn't say
+  feature?: boolean;
+  pages?: { words: TKnownWord[]; next_cursor: string | null }[];
+  status?: number;
+};
+
+function fakeServer({ shared = true, feature = shared, pages = [], status = 200 }: TServer) {
+  const requests: string[] = [];
+  const fetchMock = vi.fn(async (input: string | URL | Request, init: RequestInit = {}) => {
+    const url = new URL(String(input));
+    requests.push(`${url.pathname}${url.search}`);
+    const headers = init.headers as Record<string, string>;
+    const json = (code: number, body: unknown) =>
+      new Response(JSON.stringify(body), { status: code, headers: { "Content-Type": "application/json" } });
+    if (headers.Authorization !== "Bearer secret") {
+      return json(401, { error: { code: "unauthorized", message: "the access key is not valid (invalid)" } });
+    }
+    if (status !== 200) return json(status, { error: { message: "down" } });
+    if (url.pathname.endsWith("/v1/me")) {
+      return json(200, { user: { id: "u1" }, features: feature === undefined ? {} : { known_words: feature } });
+    }
+    if (url.pathname.endsWith("/v1/known-words")) {
+      if (!shared) return json(200, { words: [], next_cursor: null, shared: false });
+      const index = Number(url.searchParams.get("cursor") ?? 0);
+      return json(200, { ...pages[index], shared: true });
+    }
+    return json(404, {});
+  });
+  const api = new FlashcardsApi(SERVER, "secret", fetchMock as unknown as typeof fetch);
+  return { api, requests, fetchMock };
+}
+
+function memoryStorage(initial: Record<string, unknown>): TStorage {
+  const data = new Map(Object.entries(initial));
+  return {
+    get: async (keys) => Object.fromEntries(keys.filter((key) => data.has(key)).map((key) => [key, data.get(key)])),
+    set: async (items) => {
+      for (const [key, value] of Object.entries(items)) data.set(key, value);
+    },
+    remove: async (keys) => keys.forEach((key) => data.delete(key)),
+  };
+}
+
+describe("known words from Flashcard", () => {
+  it("reads every page by its cursor and keeps the known and learning words", async () => {
+    const { api, requests } = fakeServer({
+      pages: [
+        { words: [word("key", "known"), word("pick up", "learning")], next_cursor: "1" },
+        { words: [word("train", "learning"), word("seven", "new")], next_cursor: "2" },
+        { words: [word("station", "learning")], next_cursor: null },
+      ],
+    });
+
+    expect(await readKnownWords(api, "en")).toEqual({
+      shared: true,
+      words: [
+        word("key", "known"),
+        word("pick up", "learning"),
+        word("train", "learning"),
+        word("station", "learning"),
+      ],
+    });
+    expect(requests).toEqual([
+      "/subtitle/v1/me",
+      "/subtitle/v1/known-words?lang=en",
+      "/subtitle/v1/known-words?lang=en&cursor=1",
+      "/subtitle/v1/known-words?lang=en&cursor=2",
+    ]);
+  });
+
+  it("says when Flashcard doesn't share the words, without asking for them", async () => {
+    const { api, requests } = fakeServer({ shared: false });
+    expect(await readKnownWords(api, "en")).toEqual({ shared: false, words: [] });
+    expect(requests).toEqual(["/subtitle/v1/me"]);
+  });
+
+  it("takes a page's shared: false as not shared, from a server whose /me doesn't say", async () => {
+    const { api } = fakeServer({ shared: false, feature: undefined });
+    expect(await readKnownWords(api, "en")).toEqual({ shared: false, words: [] });
+  });
+
+  it("stops at a cursor it has seen and after the last page it reads", async () => {
+    const looping = fakeServer({
+      pages: [
+        { words: [word("key", "learning")], next_cursor: "1" },
+        { words: [word("train", "learning")], next_cursor: "1" },
+      ],
+    });
+    expect(await readKnownWords(looping.api, "en")).toEqual({
+      shared: true,
+      words: [word("key", "learning"), word("train", "learning")],
+    });
+    expect(looping.requests).toHaveLength(3);
+
+    const endless = fakeServer({
+      pages: Array.from({ length: KNOWN_WORDS_MAX_PAGES + 5 }, (_, index) => ({
+        words: [word(`w${index}`, "learning")],
+        next_cursor: String(index + 1),
+      })),
+    });
+    expect((await readKnownWords(endless.api, "en")).words).toHaveLength(KNOWN_WORDS_MAX_PAGES);
+  });
+
+  it("asks with the saved server and key, and says what's wrong in Turkish", async () => {
+    const pages = [{ words: [word("key", "learning")], next_cursor: null }];
+    const saved = { [KEYS.server]: JSON.stringify({ url: SERVER, token: "secret", deckId: null }) };
+    const { fetchMock } = fakeServer({ pages });
+    const flashcards = (storage: TStorage) =>
+      createFlashcards({
+        storage,
+        schedule: () => {},
+        api: (server) => new FlashcardsApi(server.url, server.token, fetchMock as unknown as typeof fetch),
+      });
+
+    expect(await flashcards(memoryStorage(saved)).handle({ action: "knownWords", lang: "en" })).toEqual({
+      shared: true,
+      words: [word("key", "learning")],
+    });
+
+    await expect(flashcards(memoryStorage({})).handle({ action: "knownWords", lang: "en" })).rejects.toThrow(
+      "Önce Subtitle Kartları'nın sunucu adresini ve anahtarını kaydet",
+    );
+
+    const wrongKey = { [KEYS.server]: JSON.stringify({ url: SERVER, token: "wrong", deckId: null }) };
+    await expect(
+      flashcards(memoryStorage(wrongKey)).handle({ action: "knownWords", lang: "en" }),
+    ).rejects.toMatchObject({ kind: "auth", message: expect.stringMatching(/^Erişim anahtarı geçersiz/) });
+  });
+});
