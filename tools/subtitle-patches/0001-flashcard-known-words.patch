+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { Provider } from "effector-react";
+import { fork } from "effector";
+import { afterEach, expect, it, vi } from "vitest";
+import "@src/models/init";
+import { $subsLanguage } from "@src/models/subs";
+import { $words } from "@src/models/words";
+import { answerNextMessage } from "@root/test/chrome";
+import { FLASHCARDS_NOT_SHARED, FlashcardsRow } from "./Words";
+
+// "Flashcard'dan oku": what the row says after reading, in its status line
+
+async function pressRead() {
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  const scope = fork({ values: [[$subsLanguage, "en"]] });
+  const node = document.createElement("div");
+  document.body.appendChild(node);
+  const root = createRoot(node);
+  await act(async () =>
+    root.render(
+      <Provider value={scope}>
+        <FlashcardsRow />
+      </Provider>,
+    ),
+  );
+  const button = node.querySelector("button")!;
+  expect(button.textContent).toBe("Flashcard'dan oku");
+  await act(async () => button.click());
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, 0));
+  });
+  const status = node.querySelector('[role="status"]')!.textContent;
+  const words = scope.getState($words);
+  root.unmount();
+  node.remove();
+  return { status, words };
+}
+
+afterEach(() => vi.unstubAllGlobals());
+
+it("says when Flashcard doesn't share its words", async () => {
+  answerNextMessage("flashcards", { shared: false, words: [] });
+  const { status, words } = await pressRead();
+  expect(status).toBe(FLASHCARDS_NOT_SHARED);
+  expect(words).toEqual({});
+});
+
+it("says how many words it read", async () => {
+  answerNextMessage("flashcards", { shared: true, words: [{ lemma: "seven", lang: "en", status: "learning" }] });
+  answerNextMessage("wordRanks", { ranks: {} });
+  const { status, words } = await pressRead();
+  expect(status).toBe("1 kelime okundu, 1 değişti");
+  expect(words["en:seven"]).toMatchObject({ status: "learning", flashcards: true });
+});
+
+it("says what went wrong", async () => {
+  answerNextMessage("flashcards", { error: "Önce Subtitle Kartları'nın sunucu adresini ve anahtarını kaydet" });
+  const { status } = await pressRead();
+  expect(status).toBe("Önce Subtitle Kartları'nın sunucu adresini ve anahtarını kaydet");
+});
